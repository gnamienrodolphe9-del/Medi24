# Copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais enregistrer .env.local dans le dépôt de code.

# Projet Supabase : Paramètres du projet > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle-anon-publique

# Cle de service : secrète, uniquement côté serveur (jamais dans une page ou un composant client)
SUPABASE_SERVICE_ROLE_KEY=cle-service-secrete

# Adresse publique du site, utilisée dans les liens envoyés par SMS
# En local : http://localhost:3000 (les SMS sont alors simulés, voir ci-dessous)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fournisseur de SMS : "console" (test : le SMS s'écrit dans le terminal), "smspro" ou "twilio"
SMS_FOURNISSEUR=console

# Seulement si SMS_FOURNISSEUR=smspro
SMSPRO_CLE=
SMSPRO_EXPEDITEUR=Medi24

# Seulement si SMS_FOURNISSEUR=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# ou, à la place de TWILIO_FROM :
TWILIO_MESSAGING_SERVICE_SID=

# SMS facultatifs ("oui" ou "non"). Par défaut, seuls le code de vérification, les alertes aux
# pharmacies et le lien du livreur partent par SMS ; le reste se passe dans l'application.
SMS_PATIENT=non
SMS_RAPPEL=non
SMS_CONFIRMATION_PHARMACIE=non
SMS_GARDE_SOIR=oui

# Notifications push (gratuites). Elles s'ajoutent aux SMS : la notification arrive en une seconde,
# le SMS reste le filet de sécurité. Générer les clés UNE fois avec : npx.cmd web-push generate-vapid-keys
# La clé publique va dans NEXT_PUBLIC_VAPID_PUBLIC_KEY, la clé privée dans VAPID_PRIVATE_KEY (secrète).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Facultatif : adresse de contact des notifications (par défaut : l'adresse du site)
VAPID_SUJET=

# Mode test ("oui" pour vos essais seulement) : le code de vérification s'affiche à l'écran
# (avec SMS_FOURNISSEUR=console) et la page Admin > Messages montre chaque SMS et chaque
# notification avec son lien cliquable. À retirer avant le vrai pilote.
MODE_TEST=non

# Secret des tâches automatiques (cascade, rappels, rapport, purge).
# Inventer une longue valeur au hasard ; la même doit être dans supabase/migrations/0004_planification.sql
CRON_SECRET=

# Votre numéro (10 chiffres, format +225...) : reçoit le rapport du matin et les alertes de supervision
ADMIN_TELEPHONE=
